{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@selvedge/core": ["./libs/core/src/index.ts"],
      "@selvedge/contracts": ["./libs/contracts/src/index.ts"]
    },
    "rootDir": "."
  }
}
